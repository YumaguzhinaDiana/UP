<Window x:Class="ShoesShop.Views.OrdersList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoesShop.Views"
        mc:Ignorable="d"
        Title="Список заказов" Height="450" Width="800" Loaded="Window_Loaded" Icon="/Resources/Icon.ico" WindowState="Maximized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Background="#7FFF00">
            <Image x:Name="logo_img" Width="70" Height="70" Source="/Resources/Icon.png" HorizontalAlignment="Left"/>
            <StackPanel x:Name="admin_panel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Margin" Value="10,0"/>
                        <Setter Property="Background" Value="#00FA9A"/>
                        <Setter Property="FontSize" Value="17"/>
                    </Style>
                </StackPanel.Resources>
                <Button x:Name="addOrder_btn" Content="Добавить заказ" HorizontalAlignment="Center" Click="addOrder_btn_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="user_tbx" FontSize="16"/>
                <Button x:Name="back_btn" Content="Назад" HorizontalAlignment="Right" Margin="5,0" Click="back_btn_Click" FontSize="16"/>

            </StackPanel>
        </Grid>
       
        <Grid Grid.Row="2">
            <ListView x:Name="orders_lstv" HorizontalContentAlignment="Stretch">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Редактировать" Click="MenuItem_Click"/>

                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>
        </Grid>

    </Grid>
</Window>
