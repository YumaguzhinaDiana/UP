<Window x:Class="ShoesShop.Views.AddEditOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoesShop.Views"
        mc:Ignorable="d"
        Title="Добавление/редактирование заказа" Height="auto" Width="800" Loaded="Window_Loaded" Icon="/Resources/Icon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#7FFF00">
            <Button x:Name="back_btn" Content="Назад" FontSize="16" HorizontalAlignment="Left" Background="#00FA9A" Click="back_btn_Click"/>
            <TextBlock x:Name="title_tblk" Text="Добавление" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel.Resources>
                    <Style TargetType="ComboBox">
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="Margin" Value="0,3,0,10"/>
                    </Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="Margin" Value="0,0,0,3"/>
                    </Style>
                </StackPanel.Resources>
                <TextBlock Text="Артикул заказа"/>
                <TextBlock x:Name="id_tbx" Text="ID"/>
                <TextBlock Text="Клиент"/>
                <ComboBox x:Name="client_cmbx" />
                <TextBlock Text="Пункт выдачи"/>
                <ComboBox x:Name="address_cmbx" />
                <TextBlock Text="Дата заказа"/>
                <DatePicker x:Name="orderDate_dpk" SelectedDateChanged="orderDate_dpk_SelectedDateChanged"/>
                <TextBlock Text="Дата доставки"/>
                <DatePicker x:Name="orderDeliveryDate_dpk" SelectedDateChanged="orderDeliveryDate_dpk_SelectedDateChanged"/>
                <TextBlock Text="Код получения"/>
                <TextBlock Text="Code" x:Name="orderCode_tbx"/>
                <TextBlock Text="Статус"/>
                <ComboBox x:Name="status_cmbx" />
                <Grid HorizontalAlignment="Center" Margin="0,10">
                    <Button x:Name="add_btn" Content="Добавить" Background="#00FA9A" Click="add_btn_Click"/>
                    <StackPanel Orientation="Horizontal" Visibility="Collapsed" x:Name="edit_panel">
                        <Button x:Name="edit_btn" Content="Сохранить" Click="edit_btn_Click"/>
                        <Button x:Name="delete_btn" Content="Удалить" Margin="5,0" Click="delete_btn_Click"/>
                    </StackPanel>
                </Grid>

            </StackPanel>
            <StackPanel Grid.Column="1">
                <StackPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="Margin" Value="0,0,0,3"/>
                    </Style>
                    <Style TargetType="Button">
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="Margin" Value="0,5,0,3"/>
                    </Style>
                </StackPanel.Resources>
                <TextBlock Text="Товары"/>
                <ListView x:Name="goods_lst" HorizontalContentAlignment="Stretch">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Убрать" Click="MenuItem_Click"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                </ListView>
                <TextBlock Text="Выбрать товар"/>
                <ComboBox x:Name="goods_cmbx" />
                <Button x:Name="addGood_btn" Content="Внести товар" HorizontalAlignment="Center" Click="addGood_btn_Click"/>
            </StackPanel>
        </Grid>
        
    </Grid>
</Window>
